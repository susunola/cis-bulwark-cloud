#!/usr/bin/env ruby
# frozen_string_literal: true

# cis - CIS Tencent Cloud Foundation Benchmark v1.0.0 (plain Terraform)
#
#   cis list                        show the control registry and what is selected
#   cis scan                        read-only assessment of the selected controls
#   cis plan                        show what `cis apply` would change
#   cis apply                       enforce the selected controls
#   cis destroy STACK               roll back one hardening stack
#
# Filtering (composable; all of them also work as CIS_* environment variables):
#
#   --only 3.5,4.*                  exactly these ids/globs, ignoring `enabled:`
#   --exclude 4.6                   drop these ids/globs, applied last
#   --section 3,4                   restrict to these benchmark sections
#   --tag cos,encryption            keep controls carrying ANY of these tags
#   --profile level1                keep Level 1 controls only
#
# Output / behaviour:
#
#   --format table|json|markdown|html   default: table
#   -o, --output PATH                   write the list/scan report to a file
#   --report [PATH]                     after `apply`, write an HTML hardening
#                                        report (default: cis-hardening-<ts>.html)
#   --dry-run                           print the terraform commands, run nothing
#   --verbose                           echo each terraform invocation
#   --no-color                          disable ANSI colour

require "optparse"
require_relative "../lib/cis"

COMMANDS = %w[list scan plan apply destroy].freeze

options = { format: "table" }
filters = {}

parser = OptionParser.new do |o|
  o.banner = "Usage: cis {#{COMMANDS.join('|')}} [options]"

  o.separator ""
  o.separator "Filtering:"
  o.on("--only IDS",      "Comma separated control ids or globs (e.g. 3.5,4.*)") { |v| filters["CIS_ONLY"] = v }
  o.on("--exclude IDS",   "Comma separated ids or globs to drop")                { |v| filters["CIS_EXCLUDE"] = v }
  o.on("--section NUMS",  "Comma separated benchmark sections (e.g. 3,4)")       { |v| filters["CIS_SECTIONS"] = v }
  o.on("--tag TAGS",      "Comma separated tags; matches ANY")                   { |v| filters["CIS_TAGS"] = v }
  o.on("--profile LEVEL", "level1 or level2")                                    { |v| filters["CIS_PROFILE"] = v }

  o.separator ""
  o.separator "Output:"
  o.on("--format FORMAT", %w[table json markdown html], "table (default), json, markdown, html") { |v| options[:format] = v }
  o.on("-o", "--output PATH", "Write the list/scan report to a file (any format)") { |v| options[:output] = v }
  o.on("--report [PATH]", "After `apply`, write an HTML hardening report (default: cis-hardening-<ts>.html)") { |v| options[:report] = v || true }
  o.on("--dry-run",  "Print what would run, execute nothing") { options[:dry_run] = true }
  o.on("--verbose",  "Echo each terraform invocation")        { options[:verbose] = true }
  o.on("--no-color", "Disable ANSI colour")                   { options[:color] = false }

  o.separator ""
  o.separator "Examples:"
  o.separator "  cis list --profile level1"
  o.separator "  cis scan --section 3,4 --format json"
  o.separator "  cis scan --section 4 --format html --output report.html"
  o.separator "  cis plan --only 4.*"
  o.separator "  cis apply --tag cos --exclude 4.6 --report"
  o.on("-h", "--help", "Show this message") { puts o; exit 0 }
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  warn "error: #{e.message}"
  warn parser.to_s
  exit 2
end

command = ARGV.shift
if command.nil?
  warn parser.to_s
  exit 2
end
unless COMMANDS.include?(command)
  warn "error: unknown command #{command.inspect}. Expected one of: #{COMMANDS.join(', ')}"
  exit 2
end

filters.each { |k, v| ENV[k] = v }
Cis.reset!

begin
  selector = Cis.selector
rescue Cis::Error => e
  warn "error: #{e.message}"
  exit 2
end

if selector.empty? && command != "list"
  warn "error: the current filters select 0 controls; nothing to do."
  exit 2
end

runner = Cis::Runner.new(selector: selector, options: options)

exit_code =
  case command
  when "list"    then runner.list
  when "scan"    then runner.scan
  when "plan"    then runner.plan
  when "apply"   then runner.apply
  when "destroy"
    stack = ARGV.shift
    if stack.nil?
      warn "error: `cis destroy` needs a stack name (#{Cis::HARDENING_STACKS.join(', ')})"
      exit 2
    end
    runner.destroy(stack)
  end

exit exit_code
